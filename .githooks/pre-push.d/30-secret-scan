#!/bin/sh
# Scans every commit about to be pushed for credentials. A commit made with
# --no-verify or from another checkout skips the pre-commit scan, so the
# push is the last local chance before the history becomes public.
set -eu
. "$(dirname -- "$0")/../_lib/hook-env.sh"

shas=$(pushed_shas <"${HOOK_STDIN_FILE:?}") || exit 1
for sha in $shas; do
	echo "pre-push: secret scan @ $sha" >&2
	bash scripts/secret-scan.sh commits "$sha" || exit 1
done
