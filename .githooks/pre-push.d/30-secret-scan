#!/bin/sh
# Scans every commit about to be pushed for credentials. A commit made with
# --no-verify or from another checkout skips the pre-commit scan, so the
# push is the last local chance before the history becomes public. Each ref
# is scanned with the scanner and ignore list from the pushed commit's own
# tree (at_sha), so what runs is what the reviewed history contains, not
# whatever the checkout holds.
set -eu
. "$(dirname -- "$0")/../_lib/hook-env.sh"

ZERO_SHA='0000000000000000000000000000000000000000'
SHA_RE='^[0-9a-f]{40}([0-9a-f]{24})?$'

# One ref line per iteration, without a piped loop: a failure must stop the
# hook, not just a subshell.
lines=$(cat "${HOOK_STDIN_FILE:?}")
old_ifs=$IFS
IFS='
'
for line in $lines; do
	IFS=$old_ifs
	# shellcheck disable=SC2086 # WHY: split the ref line into its four fields.
	set -- $line
	[ "$#" -eq 4 ] || { echo "pre-push: malformed ref line" >&2; exit 1; }
	local_sha=$2
	remote_sha=$4
	for sha in "$local_sha" "$remote_sha"; do
		printf '%s\n' "$sha" | grep -Eq "$SHA_RE" || { echo "pre-push: malformed sha" >&2; exit 1; }
	done
	# A deleted ref pushes no content.
	[ "$local_sha" = "$ZERO_SHA" ] && continue
	echo "pre-push: secret scan ($remote_sha..$local_sha)" >&2
	at_sha "$local_sha" bash scripts/secret-scan.sh range "$local_sha" "$remote_sha" || exit 1
done
IFS=$old_ifs
