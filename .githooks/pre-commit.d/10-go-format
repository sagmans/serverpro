#!/bin/sh
# Rejects unformatted Go before it enters history. CI no longer runs on
# pushes or PRs, so this is the first gate that keeps diffs gofmt-clean.
# Reads the staged blobs through staged_git so `commit -a` and
# `commit <paths>` are judged on what the commit will contain.
set -eu
. "$(dirname -- "$0")/../_lib/hook-env.sh"

GO_PATHSPEC='*.go'

bad=''
for file in $(staged_git diff --cached --name-only --diff-filter=ACMR -- "$GO_PATHSPEC"); do
	if [ -n "$(staged_git show ":$file" | gofmt -l)" ]; then
		bad="$bad $file"
	fi
done
if [ -n "$bad" ]; then
	echo "pre-commit: gofmt needed:$bad (run: make fmt)" >&2
	exit 1
fi
