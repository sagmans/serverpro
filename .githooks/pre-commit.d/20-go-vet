#!/bin/sh
# Catches compile and vet errors in seconds, so broken code is not committed
# and only discovered by the slower pre-push gate. Skipped when no Go or
# module file is staged, to keep docs-only commits instant. Vet reads the
# working tree (whole-package analysis); that trade-off keeps it fast and
# pre-push re-checks the exact pushed commits.
set -eu
. "$(dirname -- "$0")/../_lib/hook-env.sh"
. "$(dirname -- "$0")/../_lib/clean-git-env.sh"

GO_PATHSPECS='*.go go.mod go.sum'

# shellcheck disable=SC2086 # WHY: the pathspec list is split on purpose.
[ -n "$(staged_git diff --cached --name-only --diff-filter=ACMR -- $GO_PATHSPECS)" ] || exit 0
echo "pre-commit: go vet" >&2
exec make --no-print-directory vet
