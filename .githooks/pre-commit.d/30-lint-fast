#!/bin/sh
# Runs only the fast golangci-lint analyzers on code changed since HEAD, so
# lint feedback arrives at commit time without the full suite's cost. It
# reads the working tree; the full lint runs on the pushed commits in
# pre-push through make check.
set -eu
. "$(dirname -- "$0")/../_lib/hook-env.sh"
. "$(dirname -- "$0")/../_lib/clean-git-env.sh"

GO_PATHSPEC='*.go'

[ -n "$(staged_git diff --cached --name-only --diff-filter=ACMR -- "$GO_PATHSPEC")" ] || exit 0
echo "pre-commit: golangci-lint (fast, changed code)" >&2
exec make --no-print-directory lint-fast
