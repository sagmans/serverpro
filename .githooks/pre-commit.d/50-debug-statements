#!/bin/sh
# Rejects leftover debug output in staged Go lines. The CLI's stdout is a
# JSON contract; a stray print breaks every consumer that parses it.
set -eu

# POSIX ERE (no \b) so the same pattern works with BSD grep on macOS.
# Builtin print/println and spew dumps are never used on purpose here.
DEBUG_PATTERN='^\+([^/]*[^A-Za-z0-9_.])?(println|print)\(|^\+.*spew\.(Dump|Print)'
GO_PATHSPEC='*.go'

hits=$(git diff --cached -U0 --diff-filter=ACMR -- "$GO_PATHSPEC" | grep -En "$DEBUG_PATTERN" || true)
if [ -n "$hits" ]; then
	echo "pre-commit: debug statements staged:" >&2
	echo "$hits" >&2
	exit 1
fi
