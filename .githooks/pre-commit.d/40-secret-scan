#!/bin/sh
# Blocks credentials before they reach a commit. This repo handles provider,
# Tailscale and Cloudflare tokens, and a secret in public history is leaked
# even if a later commit removes it. The scanner itself is taken from the
# index being committed, not the working tree, so an unstaged edit to it
# cannot weaken the scan; it reads the commit's own index file.
set -eu
. "$(dirname -- "$0")/../_lib/hook-env.sh"

SCANNER_PATH='scripts/secret-scan.sh'

tmp=$(mktemp -d "${TMPDIR:-/tmp}/secret-scan.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
staged_git show ":$SCANNER_PATH" >"$tmp/secret-scan.sh" || {
	echo "pre-commit: $SCANNER_PATH is not in the index; refusing to commit unscanned" >&2
	exit 1
}
GIT_INDEX_FILE=${PROJECT_HOOK_INDEX_FILE:?pre-commit needs the commit index}
export GIT_INDEX_FILE
bash "$tmp/secret-scan.sh" staged
