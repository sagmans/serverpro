#!/usr/bin/env bash
# Format-check and lint staged repo-owned shell and Python scripts before
# commit using the exact versions pinned in mise.toml. Reads staged blobs from
# the commit index via staged_git so unstaged edits never mask or trigger errors.
set -euo pipefail

# shellcheck source=.githooks/lib/helpers.sh
. "${HOOK_HELPERS:?run from .githooks (scripts/setup-hooks)}"

readonly MISE_CONFIG='mise.toml'
readonly LINT_SCRIPT='scripts/lint-scripts.sh'
readonly LIB_MISE_PIN='scripts/lib-mise-pin.sh'
readonly RUN_PINNED_MAKE='scripts/run-pinned-make.sh'

top="$(cd -- "$(git rev-parse --show-toplevel)" && pwd -P)"
cd "$top"

# Verify a required control file exists in the staged index with the expected
# regular-file mode (never a symlink) and non-empty blob content.
require_staged_control_file() {
	local path="$1"
	local mode_req="$2"
	local entry
	entry="$(staged_git ls-files -s -- "$path")"
	case "$mode_req:$entry" in
	exec:100755\ *) ;;
	any:100644\ * | any:100755\ *) ;;
	exec:*)
		echo "pre-commit: $path must be an executable regular file (mode 100755) in the index" >&2
		exit 1
		;;
	*)
		echo "pre-commit: $path must be a tracked regular file (mode 100644/100755) in the index" >&2
		exit 1
		;;
	esac
	if [ "$(staged_git cat-file -s ":$path")" -eq 0 ]; then
		echo "pre-commit: staged $path is empty" >&2
		exit 1
	fi
}

# No --diff-filter here: editing OR deleting any control file must trigger a
# full check and fail closed if any required control file vanishes.
control_changed=0
if staged_git diff --cached --quiet -- "$MISE_CONFIG" "$LINT_SCRIPT" "$LIB_MISE_PIN" "$RUN_PINNED_MAKE"; then
	control_changed=0
else
	diff_rc=$?
	if [ "$diff_rc" -eq 1 ]; then
		control_changed=1
	else
		echo "pre-commit: failed to inspect staged control files (git exit $diff_rc)" >&2
		exit "$diff_rc"
	fi
fi

snapshot="$(mktemp -d "${TMPDIR:-/tmp}/serverpro-scripts-staged.XXXXXX")"
cleanup() {
	case "$snapshot" in
	*/serverpro-scripts-staged.*) rm -rf -- "$snapshot" ;;
	esac
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
snapshot="$(cd -- "$snapshot" && pwd -P)"

# Capture git index output to files rather than process substitutions so any
# git failure aborts under set -e instead of silently yielding an empty list.
raw_list="$snapshot/.staged-list"
candidates=()
if [ "$control_changed" -eq 1 ]; then
	staged_git ls-files --stage -z >"$raw_list"
	while IFS= read -r -d '' entry; do
		mode="${entry%% *}"
		path="${entry#*	}"
		case "$mode" in
		100644 | 100755) candidates+=("$path") ;;
		esac
	done <"$raw_list"
else
	staged_git diff --cached --raw -z --no-renames --diff-filter=ACMR >"$raw_list"
	while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
		read -r _ mode _ <<<"$meta"
		case "$mode" in
		100644 | 100755) candidates+=("$path") ;;
		esac
	done <"$raw_list"
fi
rm -f -- "$raw_list"

[ "${#candidates[@]}" -gt 0 ] || [ "$control_changed" -eq 1 ] || exit 0

require_staged_control_file "$MISE_CONFIG" any
require_staged_control_file "$LIB_MISE_PIN" any
require_staged_control_file "$LINT_SCRIPT" exec
require_staged_control_file "$RUN_PINNED_MAKE" exec

# Checkout only scripts/lint-scripts.sh first so non-script commits skip the
# full tree export while keeping scripts/lint-scripts.sh as the sole filter.
staged_git checkout-index -f --prefix="$snapshot/" -- "$LINT_SCRIPT"

filtered_list="$snapshot/.filtered-list"
files=()
if [ "${#candidates[@]}" -gt 0 ]; then
	printf '%s\0' "${candidates[@]}" | bash "$snapshot/$LINT_SCRIPT" --filter >"$filtered_list"
	while IFS= read -r -d '' path; do
		files+=("$path")
	done <"$filtered_list"
	rm -f -- "$filtered_list"
fi

if [ "${#files[@]}" -eq 0 ]; then
	if [ "$control_changed" -eq 1 ]; then
		echo "pre-commit: control files changed but zero tracked repo scripts matched" >&2
		exit 1
	fi
	exit 0
fi

# Export the whole staged tree only when script targets exist so shellcheck -x
# resolves sourced helpers and scripts/lint-scripts.sh reads staged mise.toml.
staged_git checkout-index -a -f --prefix="$snapshot/"

for required in "$MISE_CONFIG" "$LIB_MISE_PIN" "$LINT_SCRIPT" "$RUN_PINNED_MAKE"; do
	if [ ! -s "$snapshot/$required" ] || [ -L "$snapshot/$required" ]; then
		echo "pre-commit: staged $required is missing, empty, or a symlink" >&2
		exit 1
	fi
done

echo "pre-commit: shell/python checks (${#files[@]} staged file(s))" >&2
(
	cd "$snapshot"
	bash "./$LINT_SCRIPT" -- "${files[@]}"
)
